# Copy to .env.local; never commit or bake secrets into an image.
AUTH_SECRET=""
AWS_REGION="us-west-2"
DDB_TABLE="bedrock-claude-codecoach"
# Execution requires an isolated, credential-free worker (see SECURITY.md).
ENABLE_CODE_EXECUTION="false"
PISTON_SERVER_URL=""
# Keep local Docker installs private; CloudFormation sets 0.0.0.0 behind its SG.
APP_BIND_ADDRESS="127.0.0.1"
